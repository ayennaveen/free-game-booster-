<UserControl x:Class="ConsoleBoost.UI.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SMART GAME LIBRARY MANAGER" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Search Box -->
                <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0" Background="#12131C" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="13" ToolTip="Search Games by Title or Platform..." />
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔍 RESCAN" Style="{StaticResource PrimaryButton}" Command="{Binding ScanGamesCommand}" Margin="0,0,10,0" />
                    <Button Content="➕ ADD GAME (.EXE)" Style="{StaticResource PrimaryButton}" Command="{Binding AddCustomExeCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Category Filter Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="ALL GAMES" Style="{StaticResource NavButton}" Height="36" Margin="0,0,6,0" Padding="12,0" Command="{Binding SelectCategoryCommand}" CommandParameter="All" />
            <Button Content="⭐ FAVOURITES" Style="{StaticResource NavButton}" Height="36" Margin="0,0,6,0" Padding="12,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Favourites" />
            <Button Content="STEAM" Style="{StaticResource NavButton}" Height="36" Margin="0,0,6,0" Padding="12,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Steam" />
            <Button Content="EPIC" Style="{StaticResource NavButton}" Height="36" Margin="0,0,6,0" Padding="12,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Epic" />
            <Button Content="XBOX" Style="{StaticResource NavButton}" Height="36" Margin="0,0,6,0" Padding="12,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Xbox" />
            <Button Content="CUSTOM" Style="{StaticResource NavButton}" Height="36" Margin="0,0,6,0" Padding="12,0" Command="{Binding SelectCategoryCommand}" CommandParameter="Custom" />
        </StackPanel>

        <!-- Main Game Cards Wrap Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredGames}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Width="280" Margin="0,0,15,15" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header Tag & Star -->
                                <Grid Grid.Row="0">
                                    <Border Background="#25283B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LauncherPlatform}" Foreground="#00F2FE" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                    <Button Content="⭐" Background="Transparent" BorderThickness="0" Foreground="#FFB74D" FontSize="14" HorizontalAlignment="Right"
                                            Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <!-- Title & Path -->
                                <StackPanel Grid.Row="1" Margin="0,10,0,12">
                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ExecutablePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Specs / Category -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#1A1C2A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="▶ BOOST &amp; PLAY" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12"
                                            Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="1" Content="🗑️" Background="Transparent" Foreground="#FF5252" BorderThickness="0" FontSize="14" Margin="8,0,0,0" ToolTip="Remove from Library (Keep Files)"
                                            Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
